### Java ###
# Bỏ qua các file đã được biên dịch
*.class
*.log
*.ctxt
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

### Maven (Công cụ quản lý thư viện và build dự án) ###
# Bỏ qua thư mục target (nơi chứa kết quả sau khi build, dung lượng rất nặng)
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
# Lưu ý: Không bỏ qua .mvn/wrapper/maven-wrapper.properties vì người khác cần nó để chạy Maven

### IDEs (Môi trường lập trình) ###
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# Eclipse / Spring Tool Suite (STS)
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

### OS (File rác của hệ điều hành) ###
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
$RECYCLE.BIN/

### Môi trường và Bảo mật ###
# Bỏ qua các file chứa biến môi trường nhạy cảm (như mật khẩu Database, Secret Key)
.env
.env.local
application-dev.properties
application-dev.yml
